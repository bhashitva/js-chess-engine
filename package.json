{
  "name": "bhash-chess-engine",
  "version": "0.1.0",
  "description": "Native Bhash (भाष) chess engine with JVM/.NET applications and a JavaScript API adapter",
  "keywords": [
    "chess",
    "chess-engine",
    "chess-ai",
    "ai",
    "minimax",
    "alpha-beta",
    "quiescence-search",
    "evaluation",
    "move-generation",
    "legal-moves",
    "transposition-table",
    "fen",
    "node",
    "browser",
    "esm",
    "commonjs",
    "no-dependencies",
    "board-game",
    "bhash",
    "devanagari",
    "jvm",
    "dotnet"
  ],
  "main": "bhash/index.cjs",
  "types": "bhash/index.d.ts",
  "files": [
    "bhash",
    "LICENSE",
    "README.md",
    "THIRD_PARTY_NOTICES.md"
  ],
  "scripts": {
    "build": "node bhash/build.mjs",
    "build:clr": "node bhash/build.mjs --clr",
    "test": "node --test test/bhash/*.test.cjs",
    "demo": "node example/bhash-demo.mjs",
    "test:compat": "node test/bhash/upstream-compat.cjs",
    "test:compat:harness": "node test/bhash/upstream-compat.cjs",
    "web:build": "node web/build.mjs",
    "web:serve": "node web/serve.mjs",
    "test:web": "node --test test/web/*.test.mjs",
    "test:web:browser": "node test/web/browser.smoke.mjs",
    "test:native": "node scripts/test-native.mjs"
  },
  "author": "bc.josefjadrny@gmail.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bhashitva/js-chess-engine.git"
  },
  "homepage": "https://github.com/bhashitva/js-chess-engine",
  "license": "MIT",
  "engines": {
    "node": ">=24"
  },
  "devDependencies": {
    "playwright": "^1.56.1"
  },
  "exports": {
    ".": {
      "types": "./bhash/index.d.ts",
      "import": "./bhash/index.mjs",
      "require": "./bhash/index.cjs"
    }
  }
}
