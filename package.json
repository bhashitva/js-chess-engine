{
  "name": "bhash-chess-engine",
  "version": "0.1.0",
  "description": "Native Bhash (भाष) chess engine with JVM/.NET applications and a JavaScript API adapter",
  "keywords": [
    "chess",
    "chess-engine",
    "chess-ai",
    "ai",
    "minimax",
    "alpha-beta",
    "quiescence-search",
    "evaluation",
    "move-generation",
    "legal-moves",
    "transposition-table",
    "zobrist",
    "fen",
    "typescript",
    "node",
    "browser",
    "esm",
    "commonjs",
    "react",
    "no-dependencies",
    "board-game",
    "bhash",
    "devanagari",
    "jvm",
    "dotnet"
  ],
  "main": "bhash/index.cjs",
  "types": "bhash/index.d.ts",
  "files": [
    "bhash",
    "LICENSE",
    "README.md",
    "THIRD_PARTY_NOTICES.md"
  ],
  "scripts": {
    "build": "node bhash/build.mjs",
    "build:clr": "node bhash/build.mjs --clr",
    "test": "node --test test/bhash/*.test.cjs",
    "demo": "node example/bhash-demo.mjs",
    "build:reference": "tsc",
    "test:reference": "jest",
    "typecheck:reference": "tsc --noEmit",
    "lint:reference": "eslint .",
    "test:compat": "jest --config jest.bhash.config.cjs --runInBand",
    "test:compat:harness": "node test/bhash/upstream-compat.cjs"
  },
  "author": "bc.josefjadrny@gmail.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bhashitva/js-chess-engine.git"
  },
  "homepage": "https://github.com/bhashitva/js-chess-engine",
  "license": "MIT",
  "engines": {
    "node": ">=24"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@types/jest": "^30.0.0",
    "@types/node": "^25.0.9",
    "conventional-changelog-cli": "^5.0.0",
    "eslint": "^9.39.2",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jest": "^29.12.1",
    "jest": "^30.2.0",
    "ts-jest": "^29.4.6",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.54.0"
  },
  "exports": {
    ".": {
      "types": "./bhash/index.d.ts",
      "import": "./bhash/index.mjs",
      "require": "./bhash/index.cjs"
    }
  }
}
