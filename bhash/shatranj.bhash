आयात मानक.पाठ्य उपनाम मानकपाठ;
आयात मानक.गणित उपनाम मानकगणित;
आयात मानक.जेसन उपनाम मानकजेसन;

// Native Bhash chess engine. Adapted from Josef Jadrny's MIT js-chess-engine.
// A1=0, H8=63. A fixed 64-scalar text mailbox avoids adding array syntax.
कार्य अक्षर(पाठ्य: पाठ, सूचक: पूर्णांक) -> पाठ { लौटाओ मानकपाठ.अंश(पाठ्य, सूचक, सूचक + 1); }
कार्य रंग(मोहरा: पाठ) -> पूर्णांक {
 यदि (मानकपाठ.लंबाई(मोहरा) != 1) { लौटाओ 0; }
 यदि (मानकपाठ.है("PNBRQK",मोहरा)) { लौटाओ 1; } यदि (मानकपाठ.है("pnbrqk",मोहरा)) { लौटाओ -1; } लौटाओ 0;
}
कार्य खाना(सूचक: पूर्णांक) -> पाठ { लौटाओ अक्षर("ABCDEFGH", सूचक % 8) + मानकजेसन.पाठबनाओ(सूचक / 8 + 1); }
कार्य क्रम(पाठ्य: पाठ) -> पूर्णांक {
 यदि (मानकपाठ.लंबाई(पाठ्य) != 2) { त्रुटि("Invalid square"); }
 मान स्तंभ: पूर्णांक = 0; मान पंक्ति: पूर्णांक = 0; मान बड़ापाठ: पाठ = मानकपाठ.बड़ाअक्षर(पाठ्य);
 जबतक (स्तंभ < 8 && अक्षर("ABCDEFGH",स्तंभ) != अक्षर(बड़ापाठ,0)) { स्तंभ = स्तंभ + 1; }
 जबतक (पंक्ति < 8 && अक्षर("12345678",पंक्ति) != अक्षर(बड़ापाठ,1)) { पंक्ति = पंक्ति + 1; }
 यदि (स्तंभ == 8 || पंक्ति == 8) { त्रुटि("Invalid square"); } लौटाओ पंक्ति * 8 + स्तंभ;
}
कार्य खंड(पाठ्य: पाठ, स्थान: पूर्णांक) -> पाठ {
 मान भाग: पूर्णांक = 0; मान सूचक: पूर्णांक = 0;
 जबतक (सूचक < मानकपाठ.लंबाई(पाठ्य)) {
  जबतक (सूचक<मानकपाठ.लंबाई(पाठ्य) && मानकपाठ.है(" \t\r\n",अक्षर(पाठ्य,सूचक))) { सूचक=सूचक+1; }
  स्थिर आरंभ: पूर्णांक=सूचक;
  जबतक (सूचक<मानकपाठ.लंबाई(पाठ्य) && !मानकपाठ.है(" \t\r\n",अक्षर(पाठ्य,सूचक))) { सूचक=सूचक+1; }
  यदि (भाग==स्थान) { लौटाओ मानकपाठ.अंश(पाठ्य,आरंभ,सूचक); } भाग=भाग+1;
 } लौटाओ "";
}

वर्ग चाल {
 सार्वजनिक मान से: पूर्णांक; सार्वजनिक मान तक: पूर्णांक; सार्वजनिक मान पदोन्नति: पाठ;
 सार्वजनिक मान अगला: चाल = रिक्त;
 निर्माता(से: पूर्णांक, तक: पूर्णांक, पदोन्नति: पाठ) { यह.से=से; यह.तक=तक; यह.पदोन्नति=पदोन्नति; }
 सार्वजनिक कार्य जेसन() -> पाठ { लौटाओ "{\"" + खाना(यह.से) + "\":\"" + खाना(यह.तक) + "\"}"; }
}
वर्ग बिसात {
 सार्वजनिक मान खाने: पाठ = "................................................................";
 सार्वजनिक मान बारी: पूर्णांक = 1;
 सार्वजनिक मान सफेदछोटा: तार्किक = असत्य; सार्वजनिक मान सफेदबड़ा: तार्किक = असत्य;
 सार्वजनिक मान कालाछोटा: तार्किक = असत्य; सार्वजनिक मान कालाबड़ा: तार्किक = असत्य;
 सार्वजनिक मान पारमार्ग: पूर्णांक = -1; सार्वजनिक मान अर्ध: पूर्णांक = 0; सार्वजनिक मान पूर्ण: पूर्णांक = 1;
 निर्माता() {}
 सार्वजनिक कार्य प्राप्त(सूचक: पूर्णांक) -> पाठ { लौटाओ अक्षर(यह.खाने,सूचक); }
 सार्वजनिक कार्य रखो(सूचक: पूर्णांक, मोहरा: पाठ) -> शून्य { यह.खाने = मानकपाठ.अंश(यह.खाने,0,सूचक) + मोहरा + मानकपाठ.अंश(यह.खाने,सूचक+1,64); }
 सार्वजनिक कार्य प्रतिलिपि() -> बिसात {
  स्थिर पट: बिसात = नया बिसात(); पट.खाने=यह.खाने; पट.बारी=यह.बारी;
  पट.सफेदछोटा=यह.सफेदछोटा; पट.सफेदबड़ा=यह.सफेदबड़ा; पट.कालाछोटा=यह.कालाछोटा; पट.कालाबड़ा=यह.कालाबड़ा; पट.पारमार्ग=यह.पारमार्ग; पट.अर्ध=यह.अर्ध; पट.पूर्ण=यह.पूर्ण;
  लौटाओ पट;
 }
 सार्वजनिक कार्य फेन() -> पाठ {
  मान लेख: पाठ = ""; मान पाँत: पूर्णांक = 7;
  जबतक (पाँत >= 0) {
   मान फाइल: पूर्णांक = 0; मान खाली: पूर्णांक = 0;
   जबतक (फाइल < 8) {
    स्थिर मोहरा: पाठ = यह.प्राप्त(पाँत*8+फाइल);
    यदि (मोहरा == ".") { खाली=खाली+1; } अन्यथा {
     यदि (खाली > 0) { लेख=लेख+मानकजेसन.पाठबनाओ(खाली); खाली=0; } लेख=लेख+मोहरा;
    } फाइल=फाइल+1;
   }
   यदि (खाली > 0) { लेख=लेख+मानकजेसन.पाठबनाओ(खाली); }
   यदि (पाँत > 0) { लेख=लेख+"/"; } पाँत=पाँत-1;
  }
  यदि (यह.बारी == 1) { लेख=लेख+" w "; } अन्यथा { लेख=लेख+" b "; }
  मान अधिकार: पाठ = "";
  यदि (यह.सफेदछोटा) { अधिकार=अधिकार+"K"; } यदि (यह.सफेदबड़ा) { अधिकार=अधिकार+"Q"; }
  यदि (यह.कालाछोटा) { अधिकार=अधिकार+"k"; } यदि (यह.कालाबड़ा) { अधिकार=अधिकार+"q"; }
  यदि (अधिकार == "") { अधिकार="-"; } लेख=लेख+अधिकार+" ";
  यदि (यह.पारमार्ग == -1) { लेख=लेख+"-"; } अन्यथा { लेख=लेख+अक्षर("abcdefgh",यह.पारमार्ग%8)+मानकजेसन.पाठबनाओ(यह.पारमार्ग/8+1); }
  लौटाओ लेख+" "+मानकजेसन.पाठबनाओ(यह.अर्ध)+" "+मानकजेसन.पाठबनाओ(यह.पूर्ण);
 }
 // Piece geometry shared by attack detection and pseudo-legal generation.
 सार्वजनिक कार्य ज्यामिति(से: पूर्णांक, तक: पूर्णांक, आक्रमण: तार्किक) -> तार्किक {
  यदि (से == तक) { लौटाओ असत्य; }
  स्थिर मोहरा: पाठ = यह.प्राप्त(से); स्थिर प्रकार: पाठ = मानकपाठ.बड़ाअक्षर(मोहरा); स्थिर पक्ष: पूर्णांक = रंग(मोहरा);
  स्थिर अंतरस्तंभ: पूर्णांक = तक%8-से%8; स्थिर अंतरपंक्ति: पूर्णांक = तक/8-से/8;
  स्थिर निरपेक्षस्तंभ: पूर्णांक = मानकगणित.निरपेक्ष(अंतरस्तंभ); स्थिर निरपेक्षपंक्ति: पूर्णांक = मानकगणित.निरपेक्ष(अंतरपंक्ति); स्थिर लक्ष्य: पाठ = यह.प्राप्त(तक);
  यदि (पक्ष == 0) { लौटाओ असत्य; }
  यदि (प्रकार == "P") {
   यदि (आक्रमण) { लौटाओ निरपेक्षस्तंभ==1 && अंतरपंक्ति==पक्ष; }
   यदि (निरपेक्षस्तंभ==1 && अंतरपंक्ति==पक्ष) { लौटाओ रंग(लक्ष्य)==-पक्ष || (तक==यह.पारमार्ग && लक्ष्य=="." && यह.प्राप्त(तक-पक्ष*8)==प्यादा(-पक्ष)); }
   यदि (अंतरस्तंभ!=0 || लक्ष्य!=".") { लौटाओ असत्य; }
   यदि (अंतरपंक्ति==पक्ष) { लौटाओ सत्य; }
   लौटाओ अंतरपंक्ति==2*पक्ष && ((पक्ष==1 && से/8==1) || (पक्ष==-1 && से/8==6)) && यह.प्राप्त(से+पक्ष*8)==".";
  }
  यदि (प्रकार == "N") { लौटाओ (निरपेक्षस्तंभ==1 && निरपेक्षपंक्ति==2) || (निरपेक्षस्तंभ==2 && निरपेक्षपंक्ति==1); }
  यदि (प्रकार == "K") { लौटाओ निरपेक्षस्तंभ<=1 && निरपेक्षपंक्ति<=1; }
  यदि (प्रकार=="B" && निरपेक्षस्तंभ!=निरपेक्षपंक्ति) { लौटाओ असत्य; }
  यदि (प्रकार=="R" && अंतरस्तंभ!=0 && अंतरपंक्ति!=0) { लौटाओ असत्य; }
  यदि (प्रकार=="Q" && अंतरस्तंभ!=0 && अंतरपंक्ति!=0 && निरपेक्षस्तंभ!=निरपेक्षपंक्ति) { लौटाओ असत्य; }
  मान कदम: पूर्णांक = 0; यदि (अंतरस्तंभ>0) { कदम=1; } यदि (अंतरस्तंभ<0) { कदम=-1; }
  यदि (अंतरपंक्ति>0) { कदम=कदम+8; } यदि (अंतरपंक्ति<0) { कदम=कदम-8; }
  मान सूचक: पूर्णांक = से+कदम;
  जबतक (सूचक!=तक) { यदि (यह.प्राप्त(सूचक)!=".") { लौटाओ असत्य; } सूचक=सूचक+कदम; } लौटाओ सत्य;
 }
 सार्वजनिक कार्य आक्रांत(तक: पूर्णांक, पक्ष: पूर्णांक) -> तार्किक {
  मान सूचक: पूर्णांक = 0;
  जबतक (सूचक<64) { यदि (रंग(यह.प्राप्त(सूचक))==पक्ष && यह.ज्यामिति(सूचक,तक,सत्य)) { लौटाओ सत्य; } सूचक=सूचक+1; } लौटाओ असत्य;
 }
 सार्वजनिक कार्य शह(पक्ष: पूर्णांक) -> तार्किक {
  मान सूचक: पूर्णांक = 0; मान राजा: पाठ = "K"; यदि (पक्ष==-1) { राजा="k"; }
  जबतक (सूचक<64) { यदि (यह.प्राप्त(सूचक)==राजा) { लौटाओ यह.आक्रांत(सूचक,-पक्ष); } सूचक=सूचक+1; } लौटाओ असत्य;
 }
 सार्वजनिक कार्य किलाबंदी(से: पूर्णांक, तक: पूर्णांक) -> तार्किक {
  मान मूल: पूर्णांक = 0; यदि (यह.बारी==-1) { मूल=56; }
  यदि (से!=मूल+4 || (तक!=मूल+6 && तक!=मूल+2) || यह.शह(यह.बारी)) { लौटाओ असत्य; }
  मान हाथी: पाठ = "R"; यदि (यह.बारी==-1) { हाथी="r"; }
  यदि (तक==मूल+6) {
   यदि ((यह.बारी==1 && !यह.सफेदछोटा) || (यह.बारी==-1 && !यह.कालाछोटा)) { लौटाओ असत्य; }
   लौटाओ यह.प्राप्त(मूल+7)==हाथी && यह.प्राप्त(मूल+5)=="." && यह.प्राप्त(मूल+6)=="." && !यह.आक्रांत(मूल+5,-यह.बारी) && !यह.आक्रांत(मूल+6,-यह.बारी);
  }
  यदि ((यह.बारी==1 && !यह.सफेदबड़ा) || (यह.बारी==-1 && !यह.कालाबड़ा)) { लौटाओ असत्य; }
  लौटाओ यह.प्राप्त(मूल)==हाथी && यह.प्राप्त(मूल+1)=="." && यह.प्राप्त(मूल+2)=="." && यह.प्राप्त(मूल+3)=="." && !यह.आक्रांत(मूल+3,-यह.बारी) && !यह.आक्रांत(मूल+2,-यह.बारी);
 }
 सार्वजनिक कार्य लगाओ(चालक: चाल) -> शून्य {
  स्थिर मोहरा: पाठ = यह.प्राप्त(चालक.से); स्थिर लक्ष्य: पाठ = यह.प्राप्त(चालक.तक); स्थिर प्रकार: पाठ = मानकपाठ.बड़ाअक्षर(मोहरा);
  यदि (प्रकार=="P" && चालक.तक==यह.पारमार्ग && लक्ष्य=="." && चालक.से%8!=चालक.तक%8) { यह.रखो(चालक.तक-यह.बारी*8,"."); }
  यह.रखो(चालक.से,"."); यह.रखो(चालक.तक,मोहरा);
  यदि (प्रकार=="P" && (चालक.तक/8==0 || चालक.तक/8==7)) { यह.रखो(चालक.तक,चालक.पदोन्नति); }
  यदि (प्रकार=="K" && मानकगणित.निरपेक्ष(चालक.तक-चालक.से)==2) {
   यदि (चालक.तक>चालक.से) { यह.रखो(चालक.तक-1,यह.प्राप्त(चालक.से+3)); यह.रखो(चालक.से+3,"."); }
   अन्यथा { यह.रखो(चालक.तक+1,यह.प्राप्त(चालक.से-4)); यह.रखो(चालक.से-4,"."); }
  }
  यदि (मोहरा=="K") { यह.सफेदछोटा=असत्य; यह.सफेदबड़ा=असत्य; } यदि (मोहरा=="k") { यह.कालाछोटा=असत्य; यह.कालाबड़ा=असत्य; }
  यदि (चालक.से==0 || चालक.तक==0) { यह.सफेदबड़ा=असत्य; } यदि (चालक.से==7 || चालक.तक==7) { यह.सफेदछोटा=असत्य; }
  यदि (चालक.से==56 || चालक.तक==56) { यह.कालाबड़ा=असत्य; } यदि (चालक.से==63 || चालक.तक==63) { यह.कालाछोटा=असत्य; }
  यह.पारमार्ग=-1; यदि (प्रकार=="P" && मानकगणित.निरपेक्ष(चालक.तक-चालक.से)==16) { यह.पारमार्ग=(चालक.से+चालक.तक)/2; }
  यह.अर्ध=यह.अर्ध+1; यदि (प्रकार=="P" || लक्ष्य!=".") { यह.अर्ध=0; }
  यदि (यह.बारी==-1) { यह.पूर्ण=यह.पूर्ण+1; } यह.बारी=-यह.बारी;
 }
 सार्वजनिक कार्य चालें() -> चाल {
  मान प्रथम: चाल = रिक्त; मान अंतिम: चाल = रिक्त; मान से: पूर्णांक = 0;
  जबतक (से<64) {
   स्थिर मोहरा: पाठ = यह.प्राप्त(से);
   यदि (रंग(मोहरा)==यह.बारी) {
    मान तक: पूर्णांक = 0;
    जबतक (तक<64) {
     स्थिर लक्ष्य: पाठ = यह.प्राप्त(तक);
     यदि (रंग(लक्ष्य)!=यह.बारी && मानकपाठ.बड़ाअक्षर(लक्ष्य)!="K" && (यह.ज्यामिति(से,तक,असत्य) || (मानकपाठ.बड़ाअक्षर(मोहरा)=="K" && यह.किलाबंदी(से,तक)))) {
      मान पदोन्नतियाँ: पाठ = "Q"; यदि (यह.बारी==-1) { पदोन्नतियाँ="q"; }
      यदि (मानकपाठ.बड़ाअक्षर(मोहरा)=="P" && (तक/8==0 || तक/8==7)) { पदोन्नतियाँ="QRBN"; यदि (यह.बारी==-1) { पदोन्नतियाँ="qrbn"; } }
