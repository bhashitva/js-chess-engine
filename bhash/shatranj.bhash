  यदि (चालक==रिक्त) { यदि (शहस्थिति) { लौटाओ -100000+तल; } लौटाओ 0; }
  स्थिर स्थिरअंक: पूर्णांक=मूल्यांकन(पट); यदि (शेषगहराई<=0) { लौटाओ स्थिरअंक; }
  मान बंध: पूर्णांक=अल्फा;
  यदि (!शहस्थिति) { यदि (स्थिरअंक>=बीटा) { लौटाओ स्थिरअंक; } यदि (स्थिरअंक>बंध) { बंध=स्थिरअंक; } }
  जबतक (चालक!=रिक्त) {
   यदि (शहस्थिति || पट.प्राप्त(चालक.तक)!="." || (मानकपाठ.बड़ाअक्षर(पट.प्राप्त(चालक.से))=="P" && (चालक.तक==पट.पारमार्ग || चालक.तक/8==0 || चालक.तक/8==7))) {
    स्थिर संतान: बिसात=पट.प्रतिलिपि(); संतान.लगाओ(चालक); स्थिर अंक: पूर्णांक=-यह.शांत(संतान,-बीटा,-बंध,शेषगहराई-1,तल+1);
    यदि (अंक>=बीटा) { लौटाओ अंक; } यदि (अंक>बंध) { बंध=अंक; }
    यदि (यह.रोका) { लौटाओ बंध; }
   } चालक=चालक.अगला;
  } लौटाओ बंध;
 }
}
वर्ग इतिहास {
 सार्वजनिक मान बिसातस्थिति: पाठ; सार्वजनिक मान चली: पाठ; सार्वजनिक मान अगला: इतिहास=रिक्त;
 निर्माता(बिसातस्थिति: पाठ, चली: पाठ) { यह.बिसातस्थिति=बिसातस्थिति; यह.चली=चली; }
}
वर्ग खेल {
 सार्वजनिक मान बिसातस्थिति: बिसात; सार्वजनिक मान इतिहाससूची: इतिहास=रिक्त; सार्वजनिक मान अंत: इतिहास=रिक्त;
 निर्माता() { यह.बिसातस्थिति=फेनपढ़ो(प्रारंभिक()); }
 निर्माता(फेन: पाठ) { यह.बिसातस्थिति=फेनपढ़ो(फेन); }
 सार्वजनिक कार्य चली(से: पाठ, तक: पाठ) -> पाठ { लौटाओ यह.चली(से,तक,"Q"); }
 सार्वजनिक कार्य चली(से: पाठ, तक: पाठ, पदोन्नति: पाठ) -> पाठ {
  स्थिर उद्गम: पूर्णांक=क्रम(से); स्थिर पट: पूर्णांक=क्रम(तक); मान चालक: चाल=यह.बिसातस्थिति.चालें();
  जबतक (चालक!=रिक्त) {
   यदि (चालक.से==उद्गम && चालक.तक==पट && मानकपाठ.बड़ाअक्षर(चालक.पदोन्नति)==मानकपाठ.बड़ाअक्षर(पदोन्नति)) {
    यह.बिसातस्थिति.लगाओ(चालक); स्थिर जेसन: पाठ=यह.बिसातस्थिति.जेसन(); स्थिर प्रविष्टि: इतिहास=नया इतिहास(जेसन,चालक.जेसन());
    यदि (यह.इतिहाससूची==रिक्त) { यह.इतिहाससूची=प्रविष्टि; } अन्यथा { यह.अंत.अगला=प्रविष्टि; } यह.अंत=प्रविष्टि; लौटाओ जेसन;
   } चालक=चालक.अगला;
  } त्रुटि("Invalid move"); लौटाओ "";
 }
 सार्वजनिक कार्य चालें() -> पाठ { लौटाओ यह.चालें(""); }
 सार्वजनिक कार्य चालें(से: पाठ) -> पाठ {
  मान लेख: पाठ="{"; मान अल्पविराम: पाठ=""; मान सूचक: पूर्णांक=0;
  यदि (से!="") { सूचक=क्रम(से); }
  स्थिर प्रथम: चाल=यह.बिसातस्थिति.चालें();
  जबतक (सूचक<64) {
   मान सूची: पाठ=""; मान विभाजक: पाठ=""; मान देखे: पाठ=" "; मान चालक: चाल=प्रथम;
   जबतक (चालक!=रिक्त) {
    यदि (चालक.से==सूचक && !मानकपाठ.है(देखे,खाना(चालक.तक))) {
     सूची=सूची+विभाजक+"\""+खाना(चालक.तक)+"\""; विभाजक=","; देखे=देखे+खाना(चालक.तक)+" ";
    } चालक=चालक.अगला;
   }
   यदि (सूची!="" || से!="") { लेख=लेख+अल्पविराम+"\""+खाना(सूचक)+"\":["+सूची+"]"; अल्पविराम=","; }
   यदि (से!="") { लौटाओ लेख+"}"; } सूचक=सूचक+1;
  } लौटाओ लेख+"}";
 }
 सार्वजनिक कार्य फेननिर्यात() -> पाठ { लौटाओ यह.बिसातस्थिति.फेन(); }
 सार्वजनिक कार्य जेसननिर्यात() -> पाठ { लौटाओ यह.बिसातस्थिति.जेसन(); }
 सार्वजनिक कार्य मोहरारखो(पाठ्य: पाठ, मोहरा: पाठ) -> शून्य { यदि (मानकपाठ.लंबाई(मोहरा)!=1 || रंग(मोहरा)==0) { त्रुटि("Invalid piece"); } यह.बिसातस्थिति.रखो(क्रम(पाठ्य),मोहरा); }
 सार्वजनिक कार्य मोहराहटाओ(पाठ्य: पाठ) -> शून्य { यह.बिसातस्थिति.रखो(क्रम(पाठ्य),"."); }
 सार्वजनिक कार्य इतिहासप्राप्त() -> पाठ {
  मान प्रविष्टि: इतिहास=यह.इतिहाससूची; मान लेख: पाठ="["; मान अल्पविराम: पाठ="";
  जबतक (प्रविष्टि!=रिक्त) { लेख=लेख+अल्पविराम+मानकपाठ.अंश(प्रविष्टि.बिसातस्थिति,0,मानकपाठ.लंबाई(प्रविष्टि.बिसातस्थिति)-1)+",\"move\":"+प्रविष्टि.चली+"}"; अल्पविराम=","; प्रविष्टि=प्रविष्टि.अगला; } लौटाओ लेख+"]";
 }
 सार्वजनिक कार्य बुद्धि(स्तर: पूर्णांक, खेलो: तार्किक, विश्लेषण: तार्किक) -> पाठ { लौटाओ यह.बुद्धि(स्तर,खेलो,विश्लेषण,0,2,1,सत्य,8192); }
 सार्वजनिक कार्य बुद्धि(स्तर: पूर्णांक, खेलो: तार्किक, विश्लेषण: तार्किक, इच्छितगहराई: पूर्णांक, शांतगहराई: पूर्णांक, विस्तारसीमा: पूर्णांक, शहविस्तार: तार्किक, क्षमता: पूर्णांक) -> पाठ {
  यदि (स्तर<1 || स्तर>5) { त्रुटि("AI level must be between 1 and 5"); }
  स्थिर खोजक: खोज=नया खोज(); खोजक.सीमा=1000;
  खोजक.शांतिगहराई=शांतगहराई;
  खोजक.क्षमता=क्षमता; खोजक.शहविस्तार=शहविस्तार;
  मान किस्म: पूर्णांक=1; जबतक (किस्म<स्तर) { खोजक.सीमा=खोजक.सीमा*3; किस्म=किस्म+1; }
  मान गहराई: पूर्णांक=1; मान श्रेष्ठ: चाल=रिक्त; मान श्रेष्ठअंक: पूर्णांक=-1000000; मान पूरीगहराई: पूर्णांक=0; मान अंकित: पाठ="[]";
  स्थिर जड़: चाल=यह.बिसातस्थिति.चालें(); यदि (जड़==रिक्त) { त्रुटि("Game is already finished"); }
  मान अधिकतमगहराई: पूर्णांक=स्तर+1; यदि (इच्छितगहराई>0) { अधिकतमगहराई=इच्छितगहराई; }
  जबतक (गहराई<=अधिकतमगहराई && !खोजक.रोका) {
   मान चालक: चाल=जड़; मान आवृत्तिश्रेष्ठ: चाल=रिक्त; मान आवृत्तिअंक: पूर्णांक=-1000000; मान लेख: पाठ="["; मान अल्पविराम: पाठ="";
   जबतक (चालक!=रिक्त && !खोजक.रोका) {
    स्थिर संतान: बिसात=यह.बिसातस्थिति.प्रतिलिपि(); संतान.लगाओ(चालक);
    स्थिर अंक: पूर्णांक=-खोजक.नेगामैक्स(संतान,गहराई-1,-1000000,1000000,1,विस्तारसीमा);
    यदि (अंक>आवृत्तिअंक) { आवृत्तिअंक=अंक; आवृत्तिश्रेष्ठ=चालक; }
    लेख=लेख+अल्पविराम+"{\"move\":"+चालक.जेसन()+",\"score\":"+मानकजेसन.पाठबनाओ(अंक)+",\"promotion\":\""+चालक.पदोन्नति+"\"}"; अल्पविराम=","; चालक=चालक.अगला;
   }
   यदि (!खोजक.रोका) { श्रेष्ठ=आवृत्तिश्रेष्ठ; श्रेष्ठअंक=आवृत्तिअंक; पूरीगहराई=गहराई; अंकित=लेख+"]"; }
   गहराई=गहराई+1;
  }
  यदि (श्रेष्ठ==रिक्त) { श्रेष्ठ=जड़; }
  यदि (खेलो) { यह.चली(खाना(श्रेष्ठ.से),खाना(श्रेष्ठ.तक),श्रेष्ठ.पदोन्नति); }
  मान परिणाम: पाठ="{\"move\":"+श्रेष्ठ.जेसन()+",\"board\":"+यह.बिसातस्थिति.जेसन();
  यदि (विश्लेषण) { परिणाम=परिणाम+",\"analysis\":"+अंकित+",\"depth\":"+मानकजेसन.पाठबनाओ(पूरीगहराई)+",\"nodesSearched\":"+मानकजेसन.पाठबनाओ(खोजक.नोड)+",\"bestScore\":"+मानकजेसन.पाठबनाओ(श्रेष्ठअंक); }
  लौटाओ परिणाम+"}";
 }
 सार्वजनिक कार्य बिसातछापो() -> शून्य {
  मान पाँत: पूर्णांक=7;
  जबतक (पाँत>=0) { मान पंक्तिपाठ: पाठ=मानकजेसन.पाठबनाओ(पाँत+1)+" "; मान फाइल: पूर्णांक=0;
   जबतक (फाइल<8) { पंक्तिपाठ=पंक्तिपाठ+यह.बिसातस्थिति.प्राप्त(पाँत*8+फाइल)+" "; फाइल=फाइल+1; } लिखो(पंक्तिपाठ); पाँत=पाँत-1;
  } लिखो("  A B C D E F G H");
 }
}
// Stateless Bhash equivalents of the original API (serialized JSON return values).
कार्य चालें(फेन: पाठ, से: पाठ) -> पाठ { स्थिर खेलक: खेल=नया खेल(फेन); लौटाओ खेलक.चालें(से); }
कार्य स्थिति(फेन: पाठ) -> पाठ { स्थिर खेलक: खेल=नया खेल(फेन); लौटाओ खेलक.जेसननिर्यात(); }
कार्य चली(फेन: पाठ, से: पाठ, तक: पाठ) -> पाठ { स्थिर खेलक: खेल=नया खेल(फेन); लौटाओ खेलक.चली(से,तक); }
कार्य बुद्धि(फेन: पाठ, स्तर: पूर्णांक, खेलो: तार्किक, विश्लेषण: तार्किक) -> पाठ { स्थिर खेलक: खेल=नया खेल(फेन); लौटाओ खेलक.बुद्धि(स्तर,खेलो,विश्लेषण); }
कार्य फेनप्राप्त(फेन: पाठ) -> पाठ { स्थिर खेलक: खेल=नया खेल(फेन); लौटाओ खेलक.फेननिर्यात(); }
