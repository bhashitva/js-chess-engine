// Standalone showcase entry. Build together with shatranj.bhash.
कार्य वैधखाना(पाठ्य: पाठ) -> तार्किक {
    यदि (लंबाई(पाठ्य) != २) { लौटाओ असत्य; }
    लौटाओ समाहित("ABCDEFGH", अक्षर(बड़ाअक्षर(पाठ्य), ०)) && समाहित("12345678", अक्षर(पाठ्य, १));
}
कार्य मुख्य() -> शून्य {
    स्थिर खेलक: खेल = नया खेल();
    लिखो("भाष शतरंज / Bhash Chess");
    लिखो("चाल: E2 E4 | AI: ai | FEN: fen | समाप्त: quit");
    खेलक.बिसातछापो();
    मान समाप्त: तार्किक = असत्य;
    जबतक (!समाप्त) {
        लिखो("आपकी चाल / Your move:");
        स्थिर आदेश: पाठ = पाठपढ़ो();
        यदि (आदेश == "quit") { समाप्त = सत्य; }
        अन्यथा यदि (आदेश == "fen") { लिखो(खेलक.फेननिर्यात()); }
        अन्यथा यदि (आदेश == "ai") {
            लिखो(खेलक.बुद्धि(१, सत्य, असत्य));
            खेलक.बिसातछापो();
        } अन्यथा {
            स्थिर उद्गम: पाठ = खंड(आदेश, ०);
            स्थिर गंतव्य: पाठ = खंड(आदेश, १);
            मान वैध: तार्किक = असत्य;
            यदि (वैधखाना(उद्गम) && वैधखाना(गंतव्य)) {
                मान चालक: चाल = खेलक.बिसातस्थिति.चालें();
                जबतक (चालक != रिक्त) {
                    यदि (चालक.से == क्रम(उद्गम) && चालक.तक == क्रम(गंतव्य)) { वैध = सत्य; }
                    चालक = चालक.अगला;
                }
            }
            यदि (वैध) {
                खेलक.चली(उद्गम, गंतव्य);
                खेलक.बिसातछापो();
            } अन्यथा { लिखो("अवैध चाल / Invalid move"); }
        }
        यदि (खेलक.बिसातस्थिति.चालें() == रिक्त) {
            यदि (खेलक.बिसातस्थिति.शह(खेलक.बिसातस्थिति.बारी)) { लिखो("शह और मात / Checkmate"); }
            अन्यथा { लिखो("गतिरोध / Stalemate"); }
            समाप्त = सत्य;
        }
    }
}
