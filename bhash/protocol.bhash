// Line protocol: initial FEN, then commands, ending with quit.
कार्य मुख्य() -> शून्य {
 स्थिर पहलीपंक्ति: पाठ=पाठपढ़ो(); स्थिर खेलक: खेल=नया खेल();
 यदि (पहलीपंक्ति=="config") { खेलक.बिसातस्थिति=फेनपढ़ो(पाठपढ़ो(),असत्य); } अन्यथा { खेलक.बिसातस्थिति=फेनपढ़ो(पहलीपंक्ति); }
 मान आदेश: पाठ=पाठपढ़ो();
 जबतक (आदेश!="quit") {
  यदि (आदेश=="fen") { लिखो(खेलक.फेननिर्यात()); }
  अन्यथा यदि (आदेश=="status") { लिखो(खेलक.जेसननिर्यात()); }
  अन्यथा यदि (आदेश=="moves") { लिखो(खेलक.चालें(पाठपढ़ो())); }
  अन्यथा यदि (आदेश=="move") { स्थिर से: पाठ=पाठपढ़ो(); स्थिर तक: पाठ=पाठपढ़ो(); स्थिर पदोन्नति: पाठ=पाठपढ़ो(); लिखो(खेलक.चली(से,तक,पदोन्नति)); }
  अन्यथा यदि (आदेश=="set") { स्थिर पाठ्य: पाठ=पाठपढ़ो(); स्थिर मोहरा: पाठ=पाठपढ़ो(); खेलक.मोहरारखो(पाठ्य,मोहरा); लिखो(खेलक.फेननिर्यात()); }
  अन्यथा यदि (आदेश=="remove") { खेलक.मोहराहटाओ(पाठपढ़ो()); लिखो(खेलक.फेननिर्यात()); }
  अन्यथा यदि (आदेश=="history") { लिखो(खेलक.इतिहासप्राप्त()); }
  अन्यथा यदि (आदेश=="ai") { स्थिर स्तर: पूर्णांक=पूर्णांकपाठ(पाठपढ़ो()); स्थिर खेलो: तार्किक=पाठपढ़ो()=="true"; स्थिर विश्लेषण: तार्किक=पाठपढ़ो()=="true"; स्थिर इच्छितगहराई: पूर्णांक=पूर्णांकपाठ(पाठपढ़ो()); स्थिर शांतगहराई: पूर्णांक=पूर्णांकपाठ(पाठपढ़ो()); स्थिर विस्तारसीमा: पूर्णांक=पूर्णांकपाठ(पाठपढ़ो()); स्थिर शहविस्तार: तार्किक=पाठपढ़ो()=="true"; स्थिर क्षमता: पूर्णांक=पूर्णांकपाठ(पाठपढ़ो()); लिखो(खेलक.बुद्धि(स्तर,खेलो,विश्लेषण,इच्छितगहराई,शांतगहराई,विस्तारसीमा,शहविस्तार,क्षमता)); }
  अन्यथा यदि (आदेश=="perft") { लिखो(मानकजेसन.पाठबनाओ(चालगणना(खेलक.बिसातस्थिति,पूर्णांकपाठ(पाठपढ़ो())))); }
  अन्यथा यदि (आदेश=="board") { खेलक.बिसातछापो(); }
  अन्यथा { त्रुटि("Unknown command"); }
  आदेश=पाठपढ़ो();
 }
}
