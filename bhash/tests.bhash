// Native engine specifications. Compile after shatranj.bhash; no JS adapter.
वर्ग परख {
 सार्वजनिक मान गिनती: पूर्णांक = ०;
 निर्माता() {}
 सार्वजनिक कार्य सत्यापित(शर्त: तार्किक, नाम: पाठ) -> शून्य {
  यदि (!शर्त) { त्रुटि("FAIL: " + नाम); }
  यह.गिनती = यह.गिनती + १;
 }
}
कार्य उपलब्ध(पट: बिसात, से: पाठ, तक: पाठ, पद: पाठ) -> तार्किक {
 मान चालक: चाल = पट.चालें();
 जबतक (चालक != रिक्त) {
  यदि (चालक.से == क्रम(से) && चालक.तक == क्रम(तक) && चालक.पदोन्नति == पद) { लौटाओ सत्य; }
  चालक = चालक.अगला;
 }
 लौटाओ असत्य;
}
कार्य मुख्य() -> शून्य {
 स्थिर जाँच: परख = नया परख();
 जाँच.सत्यापित(अक्षर("a😀क",१) == "😀", "standard text uses Unicode scalars");
 जाँच.सत्यापित(रंग("") == ० && रंग("PP") == ०, "piece membership rejects empty and multi-character text");
 जाँच.सत्यापित(मानकजेसन.पाठबनाओ(९२२३३७२०३६८५४७७५८०७) == "9223372036854775807", "integer serialization remains exact");
 जाँच.सत्यापित(मानकजेसन.पाठबनाओ(सत्य) == "true" && मानकजेसन.पाठबनाओ(असत्य) == "false", "JSON boolean spelling");
 मान सूचक: पूर्णांक = ०;
 जबतक (सूचक < ६४) {
  जाँच.सत्यापित(क्रम(खाना(सूचक)) == सूचक, "square round trip");
  सूचक = सूचक + १;
 }
 जाँच.सत्यापित(क्रम("e2") == १२, "lowercase square");
 जाँच.सत्यापित(रंग("P") == १ && रंग("k") == -१ && रंग(".") == ०, "piece colors");
 स्थिर आरंभ: बिसात = फेनपढ़ो(प्रारंभिक());
 जाँच.सत्यापित(आरंभ.फेन() == प्रारंभिक(), "FEN round trip");
 जाँच.सत्यापित(आरंभ.सफेदछोटा && आरंभ.सफेदबड़ा && आरंभ.कालाछोटा && आरंभ.कालाबड़ा, "castling rights");
 जाँच.सत्यापित(चालगणना(आरंभ, ३) == ८९०२, "opening perft");
 जाँच.सत्यापित(मूल्यांकन(आरंभ) == ०, "balanced evaluation");
 स्थिर प्रति: बिसात = आरंभ.प्रतिलिपि();
 प्रति.लगाओ(नया चाल(क्रम("E2"), क्रम("E4"), "Q"));
 जाँच.सत्यापित(आरंभ.प्राप्त(क्रम("E2")) == "P", "copy independence");
 जाँच.सत्यापित(प्रति.फेन() == "rnbqkbnr/pppppppp/8/8/4P3/8/PPPP1PPP/RNBQKBNR b KQkq e3 0 1", "pawn double move state");
 स्थिर पट: बिसात = फेनपढ़ो("4k3/8/8/8/3R4/8/3P4/4K3 w - - 0 1");
 जाँच.सत्यापित(उपलब्ध(पट, "D4", "D8", "Q"), "rook sliding");
 जाँच.सत्यापित(!उपलब्ध(पट, "D4", "D1", "Q"), "rook blocked by own pawn");
 जाँच.सत्यापित(!उपलब्ध(पट, "D4", "E5", "Q"), "rook diagonal rejected");
 पट.रखो(क्रम("D4"), "B");
 जाँच.सत्यापित(उपलब्ध(पट, "D4", "G7", "Q"), "bishop sliding");
 जाँच.सत्यापित(!उपलब्ध(पट, "D4", "D5", "Q"), "bishop orthogonal rejected");
 पट.रखो(क्रम("D4"), "N");
 जाँच.सत्यापित(उपलब्ध(पट, "D4", "F5", "Q"), "knight jump");
 जाँच.सत्यापित(!उपलब्ध(पट, "D4", "E5", "Q"), "knight diagonal rejected");
 पट.रखो(क्रम("D4"), "Q");
 जाँच.सत्यापित(उपलब्ध(पट, "D4", "D8", "Q") && उपलब्ध(पट, "D4", "G7", "Q"), "queen geometry");
 स्थिर किला: खेल = नया खेल("r3k2r/8/8/8/8/8/8/R3K2R w KQkq - 0 1");
 जाँच.सत्यापित(उपलब्ध(किला.बिसातस्थिति, "E1", "C1", "Q"), "long castle available");
 किला.चली("E1", "C1");
 जाँच.सत्यापित(किला.बिसातस्थिति.प्राप्त(क्रम("D1")) == "R" && किला.बिसातस्थिति.प्राप्त(क्रम("A1")) == ".", "castle rook relocation");
 जाँच.सत्यापित(!किला.बिसातस्थिति.सफेदछोटा && !किला.बिसातस्थिति.सफेदबड़ा, "castle rights cleared");
 स्थिर हमला: बिसात = फेनपढ़ो("k4r2/8/8/8/8/8/8/4K2R w K - 0 1");
 जाँच.सत्यापित(!उपलब्ध(हमला, "E1", "G1", "Q"), "castling through attack rejected");
 स्थिर पार: खेल = नया खेल("4k3/8/8/3pP3/8/8/8/4K3 w - d6 0 1");
 पार.चली("E5", "D6");
 जाँच.सत्यापित(पार.बिसातस्थिति.प्राप्त(क्रम("D5")) == "." && पार.बिसातस्थिति.प्राप्त(क्रम("D6")) == "P", "en passant capture");
 स्थिर पिन: बिसात = फेनपढ़ो("4k3/8/8/r4pPK/8/8/8/8 w - f6 0 1");
 जाँच.सत्यापित(!उपलब्ध(पिन, "G5", "F6", "Q"), "en passant discovered check rejected");
 सूचक = ०;
 जबतक (सूचक < ४) {
  स्थिर पद: पाठ = अक्षर("QRBN", सूचक);
  स्थिर उन्नति: खेल = नया खेल("4k3/P7/8/8/8/8/8/4K3 w - - 0 1");
  जाँच.सत्यापित(उपलब्ध(उन्नति.बिसातस्थिति, "A7", "A8", पद), "promotion generated");
  उन्नति.चली("A7", "A8", पद);
  जाँच.सत्यापित(उन्नति.बिसातस्थिति.प्राप्त(क्रम("A8")) == पद, "promotion applied");
  सूचक = सूचक + १;
 }
 स्थिर काला: खेल = नया खेल("4k3/8/8/8/8/8/p7/4K3 b - - 0 9");
 काला.चली("A2", "A1", "N");
 जाँच.सत्यापित(काला.बिसातस्थिति.प्राप्त(क्रम("A1")) == "n" && काला.बिसातस्थिति.पूर्ण == १०, "black promotion and clock");
 स्थिर मात: बिसात = फेनपढ़ो("7k/6Q1/6K1/8/8/8/8/8 b - - 0 1");
 जाँच.सत्यापित(मात.शह(-१) && मात.चालें() == रिक्त, "checkmate");
 स्थिर रुद्ध: बिसात = फेनपढ़ो("7k/5Q2/6K1/8/8/8/8/8 b - - 0 1");
 जाँच.सत्यापित(!रुद्ध.शह(-१) && रुद्ध.चालें() == रिक्त, "stalemate");
 स्थिर खोजक: खोज = नया खोज();
 जाँच.सत्यापित(खोजक.नेगामैक्स(मात, २, -१००००००, १००००००, १, ०) == -९९९९९, "mate search score");
 जाँच.सत्यापित(खोजक.नेगामैक्स(रुद्ध, २, -१००००००, १००००००, १, ०) == ०, "stalemate search score");
 स्थिर इतिहासखेल: खेल = नया खेल("4k3/8/8/8/8/8/4P3/4K3 w - - 0 17");
 इतिहासखेल.चली("E2", "E4");
 जाँच.सत्यापित(इतिहासखेल.इतिहाससूची != रिक्त && इतिहासखेल.इतिहाससूची.अगला == रिक्त, "native history entry");
 इतिहासखेल.मोहरारखो("A3", "N");
 जाँच.सत्यापित(इतिहासखेल.बिसातस्थिति.प्राप्त(क्रम("A3")) == "N", "set piece");
 इतिहासखेल.मोहराहटाओ("A3");
 जाँच.सत्यापित(इतिहासखेल.बिसातस्थिति.प्राप्त(क्रम("A3")) == ".", "remove piece");
 लिखो("Native Bhash assertions passed: " + मानकजेसन.पाठबनाओ(जाँच.गिनती));
}
